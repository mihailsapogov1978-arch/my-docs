# .env.example - Шаблон переменных окружения
# Скопируйте этот файл в .env и заполните реальными значениями

# Учётные данные для help.krista.ru
HELP_USERNAME=ваш_email@yanao.ru
HELP_PASSWORD=ваш_пароль

# ИНН организации для zakupki.gov.ru
ZAKUPKI_INN=8901038364

# Пути к директориям (опционально)
DOWNLOAD_DIR_CSV=./downloads_csv
DOWNLOAD_DIR_TICKETS=./downloads_tickets

# Настройки Selenium (опционально)
SELENIUM_HEADLESS=true
SELENIUM_TIMEOUT=30
